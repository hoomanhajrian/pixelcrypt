{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(xvfb-run -a .venv/bin/python -m pytest *)",
      "Bash(.venv/bin/python app.py)",
      "Bash(.venv/bin/python app.py --self-test)",
      "Bash(xvfb-run -a -s \"-screen 0 1280x800x24\" .venv/bin/python .claude/skills/run-app/scripts/screenshot.py)",
      "Bash(xvfb-run -a -s \"-screen 0 1280x800x24\" .venv/bin/python .claude/skills/run-app/scripts/screenshot.py --binary dist/PixelCrypt)",
      "Bash(.venv/bin/python .claude/skills/verify/scripts/bigfile_check.py *)",
      "Bash(.venv/bin/pyinstaller --clean --noconfirm pixelcrypt.spec)",
      "Bash(./dist/PixelCrypt --self-test)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ]
  }
}
